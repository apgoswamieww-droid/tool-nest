// ──────────────────────────────────────────────────────
// ToolNest — Prisma Schema
// Neon Serverless PostgreSQL + Prisma ORM
// ──────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  image     String?
  // bcrypt hash (60 chars). Null for OAuth-only accounts; used by the
  // Credentials provider in lib/auth.ts. Never returned to clients.
  passwordHash String? @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  favorites         FavoriteTool[]
  savedCalculations SavedCalculation[]
  preferences       UserPreference?
  usageHistory      ToolUsageHistory[]
  apiKeys           ApiKey[]

  @@map("users")
}

// ──────────────────────────────────────────────────────
// FAVORITE TOOLS
// ──────────────────────────────────────────────────────

model FavoriteTool {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  toolSlug  String   @db.VarChar(100)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint: one favorite per user per tool
  @@unique([userId, toolSlug])
  // Index for fast lookups
  @@index([userId])
  @@index([toolSlug])
  @@map("favorite_tools")
}

// ──────────────────────────────────────────────────────
// SAVED CALCULATIONS
// ──────────────────────────────────────────────────────

model SavedCalculation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  toolSlug  String   @db.VarChar(100)
  title     String?  @db.VarChar(200)
  toolVersion String? @db.VarChar(20)
  input     Json     @default("{}")
  result    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for common queries
  @@index([userId])
  @@index([userId, toolSlug])
  @@index([createdAt(sort: Desc)])
  @@map("saved_calculations")
}

// ──────────────────────────────────────────────────────
// USER PREFERENCES
// ──────────────────────────────────────────────────────

model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  theme     String?  @default("system") @db.VarChar(20)
  language  String?  @default("en") @db.VarChar(10)
  defaults  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ──────────────────────────────────────────────────────
// ANALYTICS EVENTS (anonymous, privacy-conscious)
// Ingested by POST /api/analytics. Stores only allowlisted,
// non-personal behavioral attributes (see lib/analytics/events.ts).
// No user relation — events are anonymous by design.
// ──────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  event      String   @db.VarChar(50)
  toolSlug   String?  @db.VarChar(100)
  page       String?  @db.VarChar(200)
  sessionId  String?  @db.VarChar(64)
  meta       Json     @default("{}")
  occurredAt DateTime @db.Timestamp(3)

  // Funnel/dashboard queries
  @@index([event, occurredAt(sort: Desc)])
  @@index([toolSlug, occurredAt(sort: Desc)])
  @@map("analytics_events")
}

// ──────────────────────────────────────────────────────
// TOOL USAGE HISTORY
// ──────────────────────────────────────────────────────

model ToolUsageHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  toolSlug  String   @db.VarChar(100)
  action    String   @db.VarChar(50)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for common queries
  @@index([userId])
  @@index([userId, toolSlug])
  @@index([userId, createdAt(sort: Desc)])
  @@index([toolSlug])
  @@map("tool_usage_history")
}

// ──────────────────────────────────────────────────────
// API KEYS (public API platform, see docs/api-platform.md)
// Keys are free — rate limits are fairness caps, not billing. Only
// sha256 hashes of keys are stored, never the raw key; the raw key is
// shown exactly once at issue time.
// ──────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  keyHash     String    @unique @db.VarChar(64) // sha256 hex of the full key
  prefix      String    @db.VarChar(20) // display form: "tn_live_a1b2…wxyz"
  quotaPerDay Int       @default(100) // daily fairness cap per key
  userId      String    @db.Uuid
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage ApiUsageLog[]

  @@index([userId])
  @@map("api_keys")
}

// ──────────────────────────────────────────────────────
// API USAGE LOGS
// One row per authenticated call. Service telemetry only — never
// request bodies, query strings, raw keys, or IPs.
// ──────────────────────────────────────────────────────

model ApiUsageLog {
  id        String   @id @default(uuid()) @db.Uuid
  apiKeyId  String   @db.Uuid
  requestId String   @db.VarChar(64)
  route     String   @db.VarChar(200)
  method    String   @db.VarChar(10)
  status    Int
  latencyMs Int?
  createdAt DateTime @default(now())

  // Relations
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  // Indexes for per-key and per-route aggregates
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([route, createdAt(sort: Desc)])
  @@map("api_usage_logs")
}
